# Copy this file to .env and fill in the values. Never commit .env.

# --- Clerk (https://dashboard.clerk.com -> your app -> Configure -> API keys) ---
# Frontend key (starts with pk_test_). Used by the React app.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Backend key (starts with sk_test_). Used by the API to fetch Clerk's public signing keys.
CLERK_SECRET_KEY=sk_test_xxx
# Origins allowed in the token's "azp" claim (where the frontend runs).
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# --- AI provider: "gemini" (default) or "openrouter" ---
AI_PROVIDER=gemini

# Google Gemini (https://aistudio.google.com/apikey), free tier
GEMINI_API_KEY=xxx
CHAT_MODEL=gemini-3.5-flash-lite
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=1536

# OpenRouter (https://openrouter.ai/keys), only if AI_PROVIDER=openrouter. Then use:
#   CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
#   EMBED_MODEL=nvidia/nemotron-3.5-embed-1b:free
#   EMBED_DIM=2048
OPENROUTER_API_KEY=

# EMBED_DIM must match the database. Change it only on a fresh database
# (Docker: docker compose down -v; local: delete the .localdb folder).

# --- Local (no Docker) only: where Postgres + pgvector runs ---
# Docker Compose sets this itself.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/contracts
